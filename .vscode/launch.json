{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Standalone ASM (GDB)",
            "type": "gdb",
            "request": "launch",
            "target": "${workspaceFolder}/native/standalone",
            "cwd": "${workspaceFolder}/native",
            "valuesFormatting": "parseText",
            "stopAtEntry": true,
            "preLaunchTask": "2. Build & Run Standalone ASM",
            "autorun": [
                "set disassembly-flavor intel"
            ]
        }
    ]
}
