{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All Native Libraries (Linux + Windows)",
            "type": "shell",
            "command": "make -C native all",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                {
                    "owner": "asm",
                    "fileLocation": ["relative", "${workspaceFolder}/native"],
                    "pattern": {
                        "regexp": "^(.*):(\\d+):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                }
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Linux Native Library (.so)",
            "type": "shell",
            "command": "make -C native linux",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Windows Native Library (.dll)",
            "type": "shell",
            "command": "make -C native windows",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Test Load Native Library",
            "type": "shell",
            "command": "python3 native/test_load.py",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Clean Native Libraries",
            "type": "shell",
            "command": "make -C native clean",
            "problemMatcher": []
        }
    ]
}
